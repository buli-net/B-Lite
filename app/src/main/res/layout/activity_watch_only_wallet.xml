<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="?android:attr/colorBackground">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <android.support.v7.widget.Toolbar android:id="@+id/toolbar_watch_only" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" android:background="?attr/colorPrimary" android:theme="@style/ThemeOverlay.AppCompat.ActionBar" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="12dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="12dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/watch_only_title" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/watch_only_tools_subtitle" android:textColor="?android:attr/textColorSecondary" android:textSize="12sp" />
            <EditText android:id="@+id/watchAddressInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="@string/watch_address_hint" android:inputType="textNoSuggestions" android:maxLines="2" />
            <EditText android:id="@+id/watchDateInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:hint="@string/watch_address_date_hint" android:inputType="text" android:maxLines="1" />
            <Button android:id="@+id/addWatchAddressButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/add_watch_address"
    style="@style/WalletPrimaryButton"
/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/watched_addresses_title" android:textStyle="bold" />
            <TextView android:id="@+id/watchedBalanceSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/watch_balance_total_zero" />
            <LinearLayout android:id="@+id/watchedAddressList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            <Button android:id="@+id/rescanWatchedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/watch_rescan_button"
    style="@style/WalletPrimaryButton"
/>
            <Button android:id="@+id/deleteWatchedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:enabled="false" android:text="@string/watch_delete_button"
    style="@style/WalletSecondaryButton"
/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
