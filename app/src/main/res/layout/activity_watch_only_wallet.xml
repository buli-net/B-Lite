<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground"
>
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_watch_only"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:theme="@style/ThemeOverlay.AppCompat.ActionBar"
        android:elevation="4dp"
        />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:background="?android:attr/colorBackground"
        android:scrollbars="vertical"
    >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
        >
            <!-- Add/watch controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp"
            >
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/watch_only_title"
                    android:textStyle="bold"
                    android:textIsSelectable="true"
                 />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/watch_only_tools_subtitle"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp"
                    android:textIsSelectable="true"
                 />
                <EditText
                    android:id="@+id/watchAddressInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="@string/watch_address_hint"
                    android:inputType="textNoSuggestions"
                    android:maxLines="2"
                 />
                <EditText
                    android:id="@+id/watchDateInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:hint="@string/watch_address_date_hint"
                    android:inputType="text"
                    android:maxLines="1"
                 />
                <Button
                    android:id="@+id/scanWatchAddressQrButton"
                    style="@style/WalletSecondaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/scan_watch_address_qr"
                 />
                <Button
                    android:id="@+id/addWatchAddressButton"
                    style="@style/WalletPrimaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/add_watch_address"
                 />
            </LinearLayout>
            <!-- Account-level public keys -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp"
            >
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/account_xpub_title"
                    android:textStyle="bold"
                    android:textIsSelectable="true"
                 />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/account_xpub_subtitle"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp"
                    android:textIsSelectable="true"
                 />
                <TextView
                    android:id="@+id/accountXpubNetwork"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textIsSelectable="true" />
                <Spinner
                    android:id="@+id/accountXpubFormat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:prompt="@string/account_xpub_format_label"
                 />
                <EditText
                    android:id="@+id/accountXpubInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:inputType="textNoSuggestions"
                    android:maxLines="3"
                 />
                <Button
                    android:id="@+id/importAccountXpubButton"
                    style="@style/WalletPrimaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/account_xpub_import"
                 />
                <Button
                    android:id="@+id/exportAccountXpubButton"
                    style="@style/WalletSecondaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/account_xpub_export"
                 />
                <TextView
                    android:id="@+id/accountXpubCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp"
                    android:textIsSelectable="true"
                 />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/account_xpub_manage_title"
                    android:textStyle="bold"
                    android:textIsSelectable="true" />
                <TextView
                    android:id="@+id/accountXpubListEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/account_xpub_manage_empty"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp"
                    android:visibility="gone"
                    android:textIsSelectable="true" />
                <LinearLayout
                    android:id="@+id/accountXpubList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />
            </LinearLayout>
            <!-- Transactions discovered from imported account public keys -->
            <LinearLayout
                android:id="@+id/accountXpubTransactionsPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone"
            >
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/account_xpub_transactions_title"
                    android:textStyle="bold"
                    android:textIsSelectable="true"
                 />
                <TextView
                    android:id="@+id/accountXpubBalance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textStyle="bold"
                    android:textIsSelectable="true" />
                <TextView
                    android:id="@+id/accountXpubTransactionsEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/account_xpub_transactions_empty"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp"
                    android:textIsSelectable="true"
                 />
                <LinearLayout
                    android:id="@+id/accountXpubTransactionList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical"
                 />
            </LinearLayout>
            <!-- Watched-address list -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp"
            >
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/watched_addresses_title"
                    android:textStyle="bold"
                    android:textIsSelectable="true"
                 />
                <TextView
                    android:id="@+id/watchedBalanceSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/watch_balance_total_zero"
                    android:textIsSelectable="true"
                 />
                <TextView
                    android:id="@+id/watchedAddressEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/watch_address_empty"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp"
                    android:textIsSelectable="true"
                 />
                <LinearLayout
                    android:id="@+id/watchedAddressList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical"
                 />
                <Button
                    android:id="@+id/deleteWatchedButton"
                    style="@style/WalletSecondaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:enabled="false"
                    android:text="@string/watch_delete_button"
                 />
            </LinearLayout>
    
        </LinearLayout>
    </ScrollView>
</LinearLayout>
