<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp">

    <EditText
        android:id="@+id/nfcSecurityCurrentPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/nfc_security_current_password"
        android:inputType="textPassword"
        android:maxLength="128"
        android:maxLines="1" />

    <EditText
        android:id="@+id/nfcSecurityNewPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/nfc_security_new_password"
        android:inputType="textPassword"
        android:maxLength="128"
        android:maxLines="1" />

    <EditText
        android:id="@+id/nfcSecurityConfirmPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/nfc_security_confirm_password"
        android:inputType="textPassword"
        android:maxLength="128"
        android:maxLines="1" />
</LinearLayout>
