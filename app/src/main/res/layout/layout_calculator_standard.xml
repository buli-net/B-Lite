<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/calculatorStandardPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/calculatorExpression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:minHeight="32dp"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="14sp"
            android:textIsSelectable="true" />

        <TextView
            android:id="@+id/calculatorResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:minHeight="58dp"
            android:text="@string/calculator_zero"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="34sp"
            android:textStyle="bold"
            android:textIsSelectable="true" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/calculatorKeypad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/calculatorKeyClear"
                style="@style/WalletSecondaryButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:tag="clear"
                android:text="@string/calculator_clear_all"
                android:contentDescription="@string/calculator_key_clear_description"
                android:textAllCaps="false"
                android:textSize="21sp" />
            <Button
                android:id="@+id/calculatorKeyOpenParenthesis"
                style="@style/WalletSecondaryButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:tag="open_parenthesis"
                android:text="@string/calculator_key_open_parenthesis"
                android:contentDescription="@string/calculator_key_open_parenthesis_description"
                android:textAllCaps="false"
                android:textSize="21sp" />
            <Button
                android:id="@+id/calculatorKeyCloseParenthesis"
                style="@style/WalletSecondaryButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:tag="close_parenthesis"
                android:text="@string/calculator_key_close_parenthesis"
                android:contentDescription="@string/calculator_key_close_parenthesis_description"
                android:textAllCaps="false"
                android:textSize="21sp" />
            <Button
                android:id="@+id/calculatorKeyDivide"
                style="@style/WalletSecondaryButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:tag="divide"
                android:text="@string/calculator_key_divide"
                android:contentDescription="@string/calculator_key_divide_description"
                android:textAllCaps="false"
                android:textSize="21sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/calculatorKey7"
                style="@style/WalletSecondaryButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:tag="digit_7"
                android:text="@string/calculator_digit_7"
                android:contentDescription="@string/calculator_digit_7"
                android:textAllCaps="false"
                android:textSize="21sp" />
            <Button
                android:id="@+id/calculatorKey8"
                style="@style/WalletSecondaryButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:tag="digit_8"
                android:text="@string/calculator_digit_8"
                android:contentDescription="@string/calculator_digit_8"
                android:textAllCaps="false"
                android:textSize="21sp" />
            <Button
                android:id="@+id/calculatorKey9"
                style="@style/WalletSecondaryButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:tag="digit_9"
                android:text="@string/calculator_digit_9"
                android:contentDescription="@string/calculator_digit_9"
                android:textAllCaps="false"
                android:textSize="21sp" />
            <Button
                android:id="@+id/calculatorKeyMultiply"
                style="@style/WalletSecondaryButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:tag="multiply"
                android:text="@string/calculator_key_multiply"
                android:contentDescription="@string/calculator_key_multiply_description"
                android:textAllCaps="false"
                android:textSize="21sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/calculatorKey4"
                style="@style/WalletSecondaryButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:tag="digit_4"
                android:text="@string/calculator_digit_4"
                android:contentDescription="@string/calculator_digit_4"
                android:textAllCaps="false"
                android:textSize="21sp" />
            <Button
                android:id="@+id/calculatorKey5"
                style="@style/WalletSecondaryButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:tag="digit_5"
                android:text="@string/calculator_digit_5"
                android:contentDescription="@string/calculator_digit_5"
                android:textAllCaps="false"
                android:textSize="21sp" />
            <Button
                android:id="@+id/calculatorKey6"
                style="@style/WalletSecondaryButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:tag="digit_6"
                android:text="@string/calculator_digit_6"
                android:contentDescription="@string/calculator_digit_6"
                android:textAllCaps="false"
                android:textSize="21sp" />
            <Button
                android:id="@+id/calculatorKeySubtract"
                style="@style/WalletSecondaryButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:tag="subtract"
                android:text="@string/calculator_key_subtract"
                android:contentDescription="@string/calculator_key_subtract_description"
                android:textAllCaps="false"
                android:textSize="21sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/calculatorKey1"
                style="@style/WalletSecondaryButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:tag="digit_1"
                android:text="@string/calculator_digit_1"
                android:contentDescription="@string/calculator_digit_1"
                android:textAllCaps="false"
                android:textSize="21sp" />
            <Button
                android:id="@+id/calculatorKey2"
                style="@style/WalletSecondaryButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:tag="digit_2"
                android:text="@string/calculator_digit_2"
                android:contentDescription="@string/calculator_digit_2"
                android:textAllCaps="false"
                android:textSize="21sp" />
            <Button
                android:id="@+id/calculatorKey3"
                style="@style/WalletSecondaryButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:tag="digit_3"
                android:text="@string/calculator_digit_3"
                android:contentDescription="@string/calculator_digit_3"
                android:textAllCaps="false"
                android:textSize="21sp" />
            <Button
                android:id="@+id/calculatorKeyAdd"
                style="@style/WalletSecondaryButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:tag="add"
                android:text="@string/calculator_key_add"
                android:contentDescription="@string/calculator_key_add_description"
                android:textAllCaps="false"
                android:textSize="21sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/calculatorKeySign"
                style="@style/WalletSecondaryButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:tag="sign"
                android:text="@string/calculator_key_sign"
                android:contentDescription="@string/calculator_key_sign_description"
                android:textAllCaps="false"
                android:textSize="21sp" />
            <Button
                android:id="@+id/calculatorKey0"
                style="@style/WalletSecondaryButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:tag="digit_0"
                android:text="@string/calculator_digit_0"
                android:contentDescription="@string/calculator_digit_0"
                android:textAllCaps="false"
                android:textSize="21sp" />
            <Button
                android:id="@+id/calculatorKeyDecimal"
                style="@style/WalletSecondaryButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:tag="decimal"
                android:text="@string/calculator_key_decimal"
                android:contentDescription="@string/calculator_key_decimal_description"
                android:textAllCaps="false"
                android:textSize="21sp" />
            <Button
                android:id="@+id/calculatorKeyPercent"
                style="@style/WalletSecondaryButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:tag="percent"
                android:text="@string/calculator_key_percent"
                android:contentDescription="@string/calculator_key_percent_description"
                android:textAllCaps="false"
                android:textSize="21sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/calculatorKeyBackspace"
                style="@style/WalletSecondaryButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:tag="backspace"
                android:text="@string/calculator_key_backspace"
                android:contentDescription="@string/calculator_key_backspace_description"
                android:textAllCaps="false"
                android:textSize="21sp" />
            <Space
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1" />
            <Space
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1" />
            <Button
                android:id="@+id/calculatorKeyEquals"
                style="@style/WalletSecondaryButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:tag="equals"
                android:text="@string/calculator_key_equals"
                android:contentDescription="@string/calculator_key_equals_description"
                android:textAllCaps="false"
                android:textSize="21sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/calculatorStandardHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingTop="8dp"
        android:paddingEnd="4dp"
        android:paddingBottom="2dp"
        android:text="@string/calculator_standard_hint"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp" />
</LinearLayout>
