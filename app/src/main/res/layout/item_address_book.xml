<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">
    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="12dp">
        <TextView
            android:id="@+id/addressBookAvatarInitials"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_contact_avatar"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="15sp"
            android:textStyle="bold" />
        <ImageView
            android:id="@+id/addressBookAvatarImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_contact_avatar"
            android:clipToOutline="true"
            android:importantForAccessibility="no"
            android:contentDescription="@string/address_book_avatar_title"
            android:scaleType="centerCrop"
            android:visibility="gone" />
    </FrameLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/addressBookName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp"
            android:textStyle="bold"
            />
        <TextView
            android:id="@+id/addressBookOrganization"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/addressBookAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="middle"
            android:maxLines="1"
            android:fontFamily="monospace"
            android:scrollHorizontally="false"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/address_book_open_hint"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="11sp" />
    </LinearLayout>
    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="10dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right_24dp" />
</LinearLayout>
