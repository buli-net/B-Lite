<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
    >
        <EditText
            android:id="@+id/sendAdditionalRecipientAddress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/recipient_hint"
            android:inputType="textNoSuggestions"
            android:maxLines="2"
            android:textSize="13sp"
         />
        <Button
            android:id="@+id/sendAdditionalRecipientRemove"
            style="@style/WalletSecondaryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/multi_recipient_remove"
         />
    </LinearLayout>
    <EditText
        android:id="@+id/sendAdditionalRecipientAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/amount_hint"
        android:inputType="numberDecimal"
        android:textSize="15sp"
     />
</LinearLayout>
