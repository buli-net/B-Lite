<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/arcadeGameToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:elevation="4dp"
        android:theme="@style/ThemeOverlay.AppCompat.ActionBar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/arcadeScoreValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/arcade_score_initial"
            android:textColor="?android:attr/textColorPrimary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/arcadeLevelValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="@string/arcade_level_initial"
            android:textColor="?android:attr/textColorPrimary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/arcadeBestValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/arcade_best_initial"
            android:textColor="?android:attr/textColorSecondary" />
    </LinearLayout>

    <wallet.games.ArcadeGameView
        android:id="@+id/arcadeGameView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="@string/arcade_game_area"
        android:padding="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp">
        <Button
            android:id="@+id/arcadePauseButton"
            style="@style/WalletSecondaryButton"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="@string/arcade_pause"
            android:textAllCaps="false" />
        <Button
            android:id="@+id/arcadeRestartButton"
            style="@style/WalletSecondaryButton"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/arcade_restart"
            android:textAllCaps="false" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <Button
                android:id="@+id/arcadeUpButton"
                style="@style/WalletSecondaryButton"
                android:layout_width="64dp"
                android:layout_height="44dp"
                android:contentDescription="@string/arcade_hard_drop"
                android:gravity="center"
                android:text="▲"
                android:textSize="24sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/arcadeLeftButton"
                    style="@style/WalletSecondaryButton"
                    android:layout_width="64dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/arcade_left"
                    android:gravity="center"
                    android:text="◀"
                    android:textSize="24sp"
                    android:textStyle="bold" />
                <Space
                    android:layout_width="28dp"
                    android:layout_height="1dp" />
                <Button
                    android:id="@+id/arcadeRightButton"
                    style="@style/WalletSecondaryButton"
                    android:layout_width="64dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/arcade_right"
                    android:gravity="center"
                    android:text="▶"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/arcadeDownButton"
                style="@style/WalletSecondaryButton"
                android:layout_width="64dp"
                android:layout_height="44dp"
                android:contentDescription="@string/arcade_down"
                android:gravity="center"
                android:text="▼"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:foregroundGravity="center">
            <Button
                android:id="@+id/arcadeActionButton"
                style="@style/WalletPrimaryButton"
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/arcade_action"
                android:textAllCaps="false"
                android:textSize="18sp" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
