<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarExpenseManager"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:elevation="4dp"
        android:theme="@style/ThemeOverlay.AppCompat.ActionBar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/expensePreviousMonthButton"
                    style="@style/WalletSecondaryButton"
                    android:layout_width="48dp"
                    android:layout_height="44dp"
                    android:contentDescription="@string/expense_month_previous"
                    android:text="@string/expense_month_previous_symbol"
                    android:textSize="22sp" />
                <TextView
                    android:id="@+id/expenseMonthLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="17sp"
                    android:textStyle="bold" />
                <Button
                    android:id="@+id/expenseNextMonthButton"
                    style="@style/WalletSecondaryButton"
                    android:layout_width="48dp"
                    android:layout_height="44dp"
                    android:contentDescription="@string/expense_month_next"
                    android:text="@string/expense_month_next_symbol"
                    android:textSize="22sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/expense_month_summary"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="17sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/expense_currency"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textStyle="bold" />
                <Spinner
                    android:id="@+id/expenseCurrencySpinner"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:spinnerMode="dropdown" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/expense_currency_hint"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/expenseNetBalanceValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/calculator_placeholder"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="24sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/expense_balance"
                    android:textColor="?android:attr/textColorSecondary" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/expense_income" android:textColor="?android:attr/textColorSecondary" />
                        <TextView android:id="@+id/expenseIncomeValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/calculator_placeholder" android:textColor="?android:attr/textColorPrimary" android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/expense_spending" android:textColor="?android:attr/textColorSecondary" />
                        <TextView android:id="@+id/expenseSpendingValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/calculator_placeholder" android:textColor="?android:attr/textColorPrimary" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
                <Button
                    android:id="@+id/expenseCopySummaryButton"
                    style="@style/WalletSecondaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/expense_copy_summary"
                    android:textAllCaps="false" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/expense_budget_title" android:textColor="?android:attr/textColorPrimary" android:textSize="17sp" android:textStyle="bold" />
                <EditText
                    android:id="@+id/expenseBudgetInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_text_input_area"
                    android:hint="@string/expense_budget_hint"
                    android:inputType="numberDecimal"
                    android:paddingStart="12dp"
                    android:paddingTop="9dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="9dp"
                    android:singleLine="true"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textColorHint="?android:attr/textColorHint" />
                <Button android:id="@+id/expenseSaveBudgetButton" style="@style/WalletPrimaryButton" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:text="@string/expense_budget_save" android:textAllCaps="false" />
                <ProgressBar
                    android:id="@+id/expenseBudgetProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="12dp"
                    android:max="100"
                    android:progress="0" />
                <TextView android:id="@+id/expenseBudgetStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/expense_budget_not_set" android:textColor="?android:attr/textColorSecondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView android:id="@+id/expenseFormTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/expense_add_title" android:textColor="?android:attr/textColorPrimary" android:textSize="17sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/expense_type" android:textColor="?android:attr/textColorPrimary" android:textStyle="bold" />
                <Spinner android:id="@+id/expenseTypeSpinner" android:layout_width="match_parent" android:layout_height="48dp" android:spinnerMode="dropdown" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/expense_amount" android:textColor="?android:attr/textColorPrimary" android:textStyle="bold" />
                <EditText android:id="@+id/expenseAmountInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:background="@drawable/bg_text_input_area" android:hint="@string/expense_amount_hint" android:inputType="numberDecimal" android:paddingStart="12dp" android:paddingTop="9dp" android:paddingEnd="12dp" android:paddingBottom="9dp" android:singleLine="true" android:textColor="?android:attr/textColorPrimary" android:textColorHint="?android:attr/textColorHint" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/expense_category" android:textColor="?android:attr/textColorPrimary" android:textStyle="bold" />
                <Spinner android:id="@+id/expenseCategorySpinner" android:layout_width="match_parent" android:layout_height="48dp" android:spinnerMode="dropdown" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/expense_date" android:textColor="?android:attr/textColorPrimary" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/expenseDateValue" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="?android:attr/textColorPrimary" />
                    <Button android:id="@+id/expenseChooseDateButton" style="@style/WalletSecondaryButton" android:layout_width="wrap_content" android:layout_height="44dp" android:text="@string/expense_choose_date" android:textAllCaps="false" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/expense_note" android:textColor="?android:attr/textColorPrimary" android:textStyle="bold" />
                <EditText android:id="@+id/expenseNoteInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_text_input_area" android:gravity="top|start" android:hint="@string/expense_note_hint" android:inputType="textCapSentences|textMultiLine" android:minLines="2" android:padding="12dp" android:textColor="?android:attr/textColorPrimary" android:textColorHint="?android:attr/textColorHint" />
                <Button android:id="@+id/expenseSaveTransactionButton" style="@style/WalletPrimaryButton" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="10dp" android:text="@string/expense_add" android:textAllCaps="false" />
                <Button android:id="@+id/expenseCancelEditButton" style="@style/WalletSecondaryButton" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="6dp" android:text="@string/expense_cancel_edit" android:textAllCaps="false" android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/expense_breakdown" android:textColor="?android:attr/textColorPrimary" android:textSize="17sp" android:textStyle="bold" />
                <TextView android:id="@+id/expenseBreakdownEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/expense_no_breakdown" android:textColor="?android:attr/textColorSecondary" />
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/expenseBreakdownRecycler" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/expense_chart_daily_title" android:textColor="?android:attr/textColorPrimary" android:textSize="16sp" android:textStyle="bold" />
                <wallet.tools.ExpenseAnalyticsChartView android:id="@+id/expenseDailyFlowChart" android:layout_width="match_parent" android:layout_height="220dp" android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/expense_chart_cumulative_title" android:textColor="?android:attr/textColorPrimary" android:textSize="16sp" android:textStyle="bold" />
                <wallet.tools.ExpenseAnalyticsChartView android:id="@+id/expenseCumulativeBalanceChart" android:layout_width="match_parent" android:layout_height="210dp" android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/expense_chart_monthly_title" android:textColor="?android:attr/textColorPrimary" android:textSize="16sp" android:textStyle="bold" />
                <wallet.tools.ExpenseAnalyticsChartView android:id="@+id/expenseMonthlyComparisonChart" android:layout_width="match_parent" android:layout_height="220dp" android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/expense_chart_category_title" android:textColor="?android:attr/textColorPrimary" android:textSize="16sp" android:textStyle="bold" />
                <wallet.tools.ExpenseAnalyticsChartView android:id="@+id/expenseCategoryDonutChart" android:layout_width="match_parent" android:layout_height="230dp" android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/expenseIncomeCategoryChartCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/expense_chart_income_category_title" android:textColor="?android:attr/textColorPrimary" android:textSize="16sp" android:textStyle="bold" />
                <wallet.tools.ExpenseAnalyticsChartView android:id="@+id/expenseIncomeCategoryDonutChart" android:layout_width="match_parent" android:layout_height="230dp" android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/expense_history" android:textColor="?android:attr/textColorPrimary" android:textSize="17sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/expense_filter" android:textColor="?android:attr/textColorPrimary" android:textStyle="bold" />
                <Spinner android:id="@+id/expenseFilterSpinner" android:layout_width="match_parent" android:layout_height="48dp" android:spinnerMode="dropdown" />
                <TextView android:id="@+id/expenseHistoryEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/expense_empty" android:textColor="?android:attr/textColorSecondary" />
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/expenseTransactionsRecycler" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
