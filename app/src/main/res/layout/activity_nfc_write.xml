<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_nfc_write"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:theme="@style/ThemeOverlay.AppCompat.ActionBar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/nfc_writer_heading"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/nfc_writer_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="?attr/colorControlHighlight"
                    android:padding="12dp"
                    android:text="@string/nfc_writer_ready"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/nfc_writer_detected"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/nfc_writer_no_tag"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textIsSelectable="true"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/nfc_writer_data_heading"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/nfc_writer_mode_label"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/nfc_writer_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:contentDescription="@string/nfc_writer_mode_label" />

                <TextView
                    android:id="@+id/nfc_writer_content_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/nfc_writer_content_label_text"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/nfc_writer_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:hint="@string/nfc_writer_content_hint_text"
                    android:inputType="textCapSentences|textMultiLine"
                    android:minHeight="88dp"
                    android:padding="10dp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textColorHint="?android:attr/textColorSecondary" />

                <LinearLayout
                    android:id="@+id/nfc_writer_mime_fields"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/nfc_writer_mime_label"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/nfc_writer_mime_type"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/nfc_writer_mime_hint"
                        android:inputType="textNoSuggestions"
                        android:singleLine="true"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textColorHint="?android:attr/textColorSecondary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/nfc_writer_contact_fields"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/nfc_writer_name_label"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textStyle="bold" />
                    <EditText
                        android:id="@+id/nfc_writer_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/nfc_writer_name_hint"
                        android:inputType="textPersonName|textCapWords"
                        android:singleLine="true"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textColorHint="?android:attr/textColorSecondary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/nfc_writer_organization_label"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textStyle="bold" />
                    <EditText
                        android:id="@+id/nfc_writer_organization"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/nfc_writer_organization_hint"
                        android:inputType="textCapWords"
                        android:singleLine="true"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textColorHint="?android:attr/textColorSecondary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/nfc_writer_job_title_label"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textStyle="bold" />
                    <EditText
                        android:id="@+id/nfc_writer_job_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/nfc_writer_job_title_hint"
                        android:inputType="textCapWords"
                        android:singleLine="true"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textColorHint="?android:attr/textColorSecondary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/nfc_writer_phone_label"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textStyle="bold" />
                    <EditText
                        android:id="@+id/nfc_writer_phone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/nfc_writer_phone_hint"
                        android:inputType="phone"
                        android:singleLine="true"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textColorHint="?android:attr/textColorSecondary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/nfc_writer_email_label"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textStyle="bold" />
                    <EditText
                        android:id="@+id/nfc_writer_email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/nfc_writer_email_hint"
                        android:inputType="textEmailAddress"
                        android:singleLine="true"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textColorHint="?android:attr/textColorSecondary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/nfc_writer_website_label"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textStyle="bold" />
                    <EditText
                        android:id="@+id/nfc_writer_website"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/nfc_writer_website_hint"
                        android:inputType="textUri"
                        android:singleLine="true"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textColorHint="?android:attr/textColorSecondary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/nfc_writer_payload_size"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/nfc_writer_payload_estimate_unavailable"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/nfc_writer_check_capability"
                    style="@style/WalletSecondaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/nfc_writer_check_capability" />

                <Button
                    android:id="@+id/nfc_writer_prepare"
                    style="@style/WalletPrimaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/nfc_writer_prepare" />

                <Button
                    android:id="@+id/nfc_writer_clear_tag"
                    style="@style/WalletSecondaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/nfc_writer_clear_button" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:padding="4dp"
                android:text="@string/nfc_writer_safety_note"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
