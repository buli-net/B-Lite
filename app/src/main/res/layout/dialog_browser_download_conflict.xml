<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp"
    android:paddingBottom="8dp"
>
    <TextView
        android:id="@+id/downloadConflictFileLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/browser_download_conflict_file_label"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp"
    />
    <EditText
        android:id="@+id/downloadConflictFileName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:singleLine="true"
        android:selectAllOnFocus="true"
        android:inputType="textCapSentences"
        android:imeOptions="actionDone"
        android:textColor="?android:attr/textColorPrimary"
        android:textColorHint="?android:attr/textColorHint"
    />
    <TextView
        android:id="@+id/downloadConflictFolderLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/browser_download_conflict_folder_label"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp"
    />
    <TextView
        android:id="@+id/downloadConflictFolder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="16sp"
    />
    <CheckBox
        android:id="@+id/downloadConflictSkipPrompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/browser_download_conflict_skip_prompt"
        android:textColor="?android:attr/textColorSecondary"
    />
</LinearLayout>
