<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical"
>

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_qr_tools"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:elevation="4dp"
        android:theme="@style/ThemeOverlay.AppCompat.ActionBar"
    />

    <ScrollView
        android:id="@+id/qr_tools_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbarStyle="outsideOverlay"
        android:scrollbars="vertical"
    >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="18dp"
        >
            <LinearLayout
                android:id="@+id/qr_tools_scan_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp"
            >
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/qr_tools_scan_section_title"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="17sp"
                    android:textStyle="bold"
                />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/qr_tools_scan_description"
                    android:textColor="?android:attr/textColorSecondary"
                />
                <TextView
                    android:id="@+id/qr_tools_scan_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="?attr/colorControlHighlight"
                    android:padding="12dp"
                    android:text="@string/qr_tools_status_ready"
                    android:textColor="?android:attr/textColorPrimary"
                />
                <Button
                    android:id="@+id/qr_tools_scan_camera"
                    style="@style/WalletPrimaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/qr_tools_scan_camera"
                />
                <Button
                    android:id="@+id/qr_tools_scan_image"
                    style="@style/WalletSecondaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/qr_tools_scan_image"
                />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/qr_tools_scan_result_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone"
            >
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/qr_tools_scan_result_title"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="17sp"
                    android:textStyle="bold"
                />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/qr_tools_scan_result_format"
                    android:textColor="?android:attr/textColorSecondary"
                />
                <TextView
                    android:id="@+id/qr_tools_scan_format_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textStyle="bold"
                />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/qr_tools_content_label"
                    android:textColor="?android:attr/textColorSecondary"
                />
                <TextView
                    android:id="@+id/qr_tools_scan_content_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="?attr/colorControlHighlight"
                    android:padding="12dp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textIsSelectable="true"
                />
                <Button
                    android:id="@+id/qr_tools_scan_copy"
                    style="@style/WalletPrimaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/qr_tools_copy_result"
                />
                <Button
                    android:id="@+id/qr_tools_scan_share"
                    style="@style/WalletSecondaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/qr_tools_share_result"
                />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/qr_tools_generate_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp"
            >
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/qr_tools_generate_section_title"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="17sp"
                    android:textStyle="bold"
                />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/qr_tools_format_label"
                    android:textColor="?android:attr/textColorSecondary"
                />
                <Spinner
                    android:id="@+id/qr_tools_format_spinner"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:spinnerMode="dropdown"
                />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/qr_tools_content_label"
                    android:textColor="?android:attr/textColorSecondary"
                />
                <EditText
                    android:id="@+id/qr_tools_content_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="top|start"
                    android:hint="@string/qr_tools_content_hint"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:minHeight="96dp"
                    android:padding="12dp"
                    android:scrollbars="vertical"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textColorHint="?android:attr/textColorHint"
                />
                <Button
                    android:id="@+id/qr_tools_generate"
                    style="@style/WalletPrimaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/qr_tools_generate"
                />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/qr_tools_generated_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone"
            >
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/qr_tools_generated_preview_title"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="17sp"
                    android:textStyle="bold"
                />
                <ImageView
                    android:id="@+id/qr_tools_generated_image"
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:layout_marginTop="12dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/qr_tools_code_content_description"
                    android:scaleType="fitCenter"
                />
                <TextView
                    android:id="@+id/qr_tools_generated_content_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="?attr/colorControlHighlight"
                    android:padding="12dp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textIsSelectable="true"
                />
                <Button
                    android:id="@+id/qr_tools_generated_copy"
                    style="@style/WalletPrimaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/qr_tools_copy_generated"
                />
                <Button
                    android:id="@+id/qr_tools_generated_share"
                    style="@style/WalletSecondaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/qr_tools_share_generated"
                />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
