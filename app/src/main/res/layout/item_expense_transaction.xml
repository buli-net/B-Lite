<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/expenseRowTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="?android:attr/textColorPrimary" android:textStyle="bold" />
        <TextView android:id="@+id/expenseRowSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="?android:attr/textColorSecondary" android:textSize="12sp" />
    </LinearLayout>
    <TextView android:id="@+id/expenseRowAmount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="8dp" android:textColor="?android:attr/textColorPrimary" android:textStyle="bold" />
</LinearLayout>
