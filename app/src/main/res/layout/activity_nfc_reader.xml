<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?android:attr/colorBackground" android:orientation="vertical">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_nfc_reader" android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" android:background="?attr/colorPrimary"
        android:theme="@style/ThemeOverlay.AppCompat.ActionBar" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:clipToPadding="false" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/bg_card" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/nfc_reader_scan_heading" android:textColor="?android:attr/textColorPrimary"
                    android:textSize="17sp" android:textStyle="bold" />
                <TextView android:id="@+id/nfc_reader_status" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="10dp"
                    android:padding="12dp" android:background="?attr/colorControlHighlight"
                    android:text="@string/nfc_reader_waiting" android:textColor="?android:attr/textColorPrimary"
                    android:textSize="15sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:text="@string/nfc_reader_instruction"
                    android:textColor="?android:attr/textColorSecondary" android:textSize="14sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:orientation="horizontal">
                    <Button android:id="@+id/nfc_reader_copy" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/nfc_reader_copy" android:enabled="false" />
                    <Button android:id="@+id/nfc_reader_clear" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginStart="8dp" android:text="@string/nfc_reader_clear" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:background="@drawable/bg_card"
                android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/nfc_reader_card_info" android:textColor="?android:attr/textColorPrimary"
                    android:textStyle="bold" android:textSize="15sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="@string/nfc_reader_id"
                    android:textColor="?android:attr/textColorSecondary" android:textStyle="bold" />
                <TextView android:id="@+id/nfc_reader_id" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:paddingTop="4dp"
                    android:textColor="?android:attr/textColorPrimary" android:textIsSelectable="true" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="@string/nfc_reader_technologies"
                    android:textColor="?android:attr/textColorSecondary" android:textStyle="bold" />
                <TextView android:id="@+id/nfc_reader_technologies_value" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:paddingTop="4dp"
                    android:textColor="?android:attr/textColorPrimary" android:textIsSelectable="true" />
            </LinearLayout>
            <LinearLayout android:id="@+id/nfc_reader_protocol_card" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:background="@drawable/bg_card"
                android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/nfc_reader_protocol_details" android:textColor="?android:attr/textColorPrimary"
                    android:textStyle="bold" android:textSize="15sp" />
                <TextView android:id="@+id/nfc_reader_protocol_value" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="10dp"
                    android:textColor="?android:attr/textColorPrimary" android:textIsSelectable="true" />
            </LinearLayout>
            <LinearLayout android:id="@+id/nfc_reader_decoded_card" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:background="@drawable/bg_card"
                android:orientation="vertical" android:padding="16dp" android:visibility="gone">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/nfc_reader_decoded_card_title" android:textColor="?android:attr/textColorPrimary"
                    android:textStyle="bold" android:textSize="17sp" />
                <LinearLayout android:id="@+id/nfc_reader_decoded_fields" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="4dp"
                    android:orientation="vertical" />
            </LinearLayout>
            <LinearLayout android:id="@+id/nfc_reader_ndef_card" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:background="@drawable/bg_card"
                android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/nfc_reader_ndef" android:textColor="?android:attr/textColorPrimary"
                    android:textStyle="bold" android:textSize="15sp" />
                <TextView android:id="@+id/nfc_reader_ndef_value" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="10dp"
                    android:textColor="?android:attr/textColorPrimary" android:textIsSelectable="true" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:layout_marginBottom="12dp"
                android:padding="4dp" android:text="@string/nfc_reader_security_note"
                android:textColor="?android:attr/textColorSecondary" android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
