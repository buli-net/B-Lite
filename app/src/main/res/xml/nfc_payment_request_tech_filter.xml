<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Ordinary NDEF Requests keep the existing higher-priority NDEF dispatch path. -->
    <tech-list>
        <tech>android.nfc.tech.Ndef</tech>
    </tech-list>
    <!-- Some password-protected Type 2 NDEF tags cannot be decoded by Android before PWD_AUTH. -->
    <tech-list>
        <tech>android.nfc.tech.NfcA</tech>
        <tech>android.nfc.tech.MifareUltralight</tech>
    </tech-list>
    <!-- Keep the existing app's supported MIFARE Classic protected-NDEF path dispatchable too. -->
    <tech-list>
        <tech>android.nfc.tech.MifareClassic</tech>
    </tech-list>
</resources>
